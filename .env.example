# Database
DATABASE_URL=postgresql://nudra:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/nudra

# Redis
REDIS_URL=redis://localhost:6379

# Session / cookies (generate a strong 64+ byte hex secret, e.g. `openssl rand -hex 64`)
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# MinIO (object storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=REPLACE_WITH_STRONG_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_STRONG_MINIO_SECRET_KEY
# Public endpoint used for thumbnails and presigned URLs
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Server
PORT=3001
NODE_ENV=development

# Frontend
VITE_API_URL=http://localhost:3001

# AI / ML services
OLLAMA_URL=http://localhost:11434
DEEPSEEK_PROXY_URL=http://192.168.1.93:4982
WHISPER_URL=http://localhost:5001
WHISPER_API_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET

# Anonymous community token salt (generate with `openssl rand -hex 32`)
ANON_TOKEN_SALT=REPLACE_WITH_ANOTHER_RANDOM_SECRET

# SMTP / Mailpit (local dev mail catcher)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@nudra.com

# CORS / security (comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting (optional, values in milliseconds / count)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
SLOW_DOWN_WINDOW_MS=900000
SLOW_DOWN_AFTER=100
SLOW_DOWN_MS=500

# Video streaming rate limits
VIDEO_RATE_LIMIT_WINDOW_MS=60000
VIDEO_RATE_LIMIT_MAX=300
FRONTEND_URL=http://localhost:3000
