# Self-hosted PostgreSQL (pgvector extension enabled in the VPS image).
DATABASE_URL=postgresql://nudra_app:replace_with_dev_password@localhost:5432/nudra
PORT=3001
NODE_ENV=development

# Generate with `openssl rand -hex 64`.
SESSION_SECRET=

# Self-hosted MinIO. Production uses the private Compose service endpoint and a
# browser-reachable Caddy URL, e.g. https://assets.nudra.org/storage.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=nudra_minio
MINIO_SECRET_KEY=replace_with_a_long_random_minio_secret
MINIO_APP_USER=nudra_app
MINIO_APP_PASSWORD=replace_with_a_long_random_minio_app_password
MINIO_REGION=us-east-1
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
PUBLIC_STORAGE_URL=http://localhost:9000

# Self-hosted Redis for BullMQ and rate-limit state.
REDIS_URL=redis://localhost:6379

# Organization domains and Caddy on-demand TLS authorization.
BASE_DOMAIN=nudra.org
ASSETS_HOST=assets.nudra.org
PUBLIC_IPV4=replace_with_vps_public_ipv4
# Generate with `openssl rand -hex 32`; configure the same secret in the
# internal Caddy domain-auth sidecar. Never expose it to the browser.
DOMAIN_AUTH_SHARED_SECRET=

# Email (Resend remains an external mail delivery API).
RESEND_API_KEY=re_XXXX
SMTP_FROM=Nudra Support <support@nudra.org>
INSTRUCTOR_INVITE_FROM=Nudra <no-reply@nudra.org>
MAIL_LOGO_URL=https://nudra.org/nudra-text-logo.png

# AI
# "development" uses the local DeepSeek web proxy and local Ollama embeddings.
# "production" uses the hosted Qwen API and hosted embeddings.
AI_ENVIRONMENT=development
DEEPSEEK_PROXY_URL=http://localhost:4981
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Transcription can use the local faster-whisper service or Groq Cloud.
# auto follows AI_ENVIRONMENT; set "local" or "groq" to override it.
TRANSCRIPTION_PROVIDER=auto
WHISPER_URL=http://localhost:5001
WHISPER_API_KEY=replace_with_local_whisper_api_key
GROQ_API_KEY=replace_with_real_groq_api_key
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Alibaba Cloud Model Studio provider used when AI_ENVIRONMENT=production.
DASHSCOPE_API_KEY=replace_with_model_studio_api_key
QWEN_API_BASE_URL=https://YOUR_WORKSPACE_ID.eu-central-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen3.7-flash
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding

# Generate with `openssl rand -hex 32`.
ANON_TOKEN_SALT=

# CORS / URLs
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:3000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
SLOW_DOWN_WINDOW_MS=900000
SLOW_DOWN_AFTER=100
SLOW_DOWN_MS=500
VIDEO_RATE_LIMIT_WINDOW_MS=60000
VIDEO_RATE_LIMIT_MAX=300
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20
