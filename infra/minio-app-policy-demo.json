{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads",
        "s3:ListMultipartUploadParts",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::nudra-demo-thumbnails",
        "arn:aws:s3:::nudra-demo-thumbnails/*",
        "arn:aws:s3:::nudra-demo-raw-videos",
        "arn:aws:s3:::nudra-demo-raw-videos/*",
        "arn:aws:s3:::nudra-demo-hls",
        "arn:aws:s3:::nudra-demo-hls/*"
      ]
    }
  ]
}
