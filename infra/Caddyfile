{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://domain-auth:8080/authorize
	}
}

# Redirect the Nudra root and wildcard tenant names to HTTPS. Unknown custom
# hosts are not redirected on HTTP; they must first pass the TLS authorization.
http://{$BASE_DOMAIN}, http://www.{$BASE_DOMAIN}, http://*.{$BASE_DOMAIN} {
	redir https://{host}{uri} 308
}

# Caddy accepts a certificate request for any SNI only after the private
# authorizer confirms the hostname against Nudra's allowlist.
https:// {
	tls {
		on_demand
		protocols tls1.2 tls1.3
	}

	@api path /api /api/* /socket.io /socket.io/*
	handle @api {
		# Caddy streams upload bodies to the API; no buffering is configured.
		reverse_proxy api:3001
	}

	@assets host {$ASSETS_HOST}
	handle @assets {
		@storage path /storage/*
		handle @storage {
			handle_path /storage/* {
				reverse_proxy minio:9000
			}
		}
		respond "Not found" 404
	}

	handle {
		reverse_proxy frontend:8080
	}
}
