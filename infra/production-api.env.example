# Copy to /opt/nudra/.env.production.api and chmod 600.
SESSION_SECRET=replace_with_a_long_random_secret
ANON_TOKEN_SALT=replace_with_a_different_long_random_secret

RESEND_API_KEY=replace_with_rotated_resend_api_key
SMTP_FROM=Nudra Support <support@nudra.org>
INSTRUCTOR_INVITE_FROM=Nudra <no-reply@nudra.org>
MAIL_LOGO_URL=https://nudra.org/nudra-text-logo.png
FRONTEND_URL=https://nudra.org
VIDEO_UPLOAD_START_LIMIT_PER_HOUR=8
VIDEO_MAX_ACTIVE_UPLOADS=8

AI_ENVIRONMENT=production
TRANSCRIPTION_PROVIDER=groq
GROQ_API_KEY=replace_with_groq_api_key
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
DASHSCOPE_API_KEY=replace_with_qwen_api_key
QWEN_API_BASE_URL=replace_with_provider_compatible_endpoint
QWEN_CHAT_MODEL=qwen3.7-flash
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=768
