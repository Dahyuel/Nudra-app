# Copy to /opt/nudra/.env.production.worker and chmod 600.
AI_ENVIRONMENT=production
TRANSCRIPTION_PROVIDER=groq
GROQ_API_KEY=replace_with_groq_api_key
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
DASHSCOPE_API_KEY=replace_with_qwen_api_key
QWEN_API_BASE_URL=replace_with_provider_compatible_endpoint
QWEN_CHAT_MODEL=qwen3.7-flash
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=768
DB_POOL_MAX=5
FFMPEG_TIMEOUT_MS=1200000
