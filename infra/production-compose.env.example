# Copy to /opt/nudra/.env.production and chmod 600.
BASE_DOMAIN=nudra.org
ASSETS_HOST=assets.nudra.org
PUBLIC_IPV4=replace_with_hostinger_vps_ipv4
ACME_EMAIL=admin@nudra.org
DOMAIN_AUTH_SHARED_SECRET=replace_with_at_least_32_random_characters

POSTGRES_DB=nudra
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=replace_with_random_password
POSTGRES_APP_USER=nudra_app
POSTGRES_APP_PASSWORD=replace_with_random_password
POSTGRES_MIGRATION_USER=nudra_migrator
POSTGRES_MIGRATION_PASSWORD=replace_with_random_password
DATABASE_URL=postgresql://nudra_app:URL_ENCODED_PASSWORD@postgres:5432/nudra
MIGRATION_DATABASE_URL=postgresql://nudra_migrator:URL_ENCODED_PASSWORD@postgres:5432/nudra
REDIS_PASSWORD=replace_with_random_password

MINIO_ROOT_USER=nudra_minio_root
MINIO_ROOT_PASSWORD=replace_with_random_password
MINIO_APP_USER=nudra_app
MINIO_APP_PASSWORD=replace_with_random_password
